{
  "schema_version": 4,
  "profile": "core",
  "upstreams": [{"id": "site-svc", "dial": "127.0.0.1:9301"}],
  "apis": [{"id": "site", "upstream": "site-svc", "forward": {"add_prefix": "/site"},
            "cors": {"origins": ["https://www.example.com", "https://example.com"], "methods": ["POST", "GET"], "headers": ["content-type"], "max_age_seconds": 0},
            "response_headers": {"nosniff": true, "frame": "sameorigin", "remove": ["X-Powered-By", "Server"]},
            "allow_addresses": ["198.51.100.0/24", "10.0.0.0/8"]}],
  "operations": [
    {"id": "site.home", "api": "site", "method": "GET", "target": "/", "access": "allow", "auth": "none"},
    {"id": "site.pages", "api": "site", "method": "GET", "target": "/pages/*", "access": "allow", "auth": "none",
     "rate": {"algorithm": "sliding-window", "count": 1, "window_seconds": 86400, "key": "client_address"}},
    {"id": "site.contact", "api": "site", "method": "POST", "target": "/contact", "access": "allow", "auth": "none",
     "body": {"max_bytes": 1048576, "schema": {"type": "array", "maxItems": 3, "items": {"type": ["string", "null"], "maxLength": 200}}},
     "rate": {"algorithm": "sliding-window", "count": 1000000, "window_seconds": 1, "key": "client_address"}},
    {"id": "site.search", "api": "site", "method": "GET", "target": "/search", "access": "allow", "auth": "none",
     "when": {"hosts": ["www.example.com", "*.example.com"], "headers": [{"name": "X-Version", "value": "2"}]}}
  ],
  "roles": [{"id": "visitor"}],
  "permits": []
}
